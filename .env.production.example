# Production Environment Variables
NODE_ENV=production
PORT=3000

# MongoDB Atlas Connection (recommended for production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nalanda_library?retryWrites=true&w=majority

# JWT Configuration (use strong secrets in production!)
JWT_SECRET=use_a_very_long_random_string_at_least_64_chars_for_production
JWT_ENCRYPTION_KEY=use_exactly_32_characters_here!
JWT_EXPIRES_IN=7d

# AWS Configuration (if using AWS services)
AWS_REGION=ap-south-1
